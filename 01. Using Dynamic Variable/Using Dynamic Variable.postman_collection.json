    {
      "name": "CreateBooking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var fName = pm.variables.replaceIn('{{$randomFirstName}}');",
              "pm.environment.set(\"firstname\", fName);",
              "",
              "var lName = pm.variables.replaceIn('{{$randomLastName}}');",
              "pm.environment.set(\"lastname\", lName);",
              "",
              "var tPrice = pm.variables.replaceIn('{{$randomInt}}');",
              "pm.environment.set(\"totalprice\", tPrice);",
              "",
              "var dPaid = pm.variables.replaceIn('{{$randomBoolean}}')",
              "pm.environment.set(\"depositpaid\", dPaid);",
              "",
              "",
              "var cIn = require('moment')().format('YYYY-MM-DD');",
              "pm.environment.set(\"checkin\", cIn);",
              "",
              "var cOut = require('moment')().add(4, 'd').format('YYYY-MM-DD');",
              "pm.environment.set(\"checkout\", cOut);",
              "",
              "// var checkin = require('moment');",
              "// var checkinDate = checkin().format('YYYY-MM-DD');",
              "// pm.environment.set(\"check\", checkinDate);",
              "var need = pm.variables.replaceIn('{{$randomTransactionType}}');",
              "pm.environment.set(\"additionalneeds\", need);",
              "",
              "",
              "// var checkin = require('moment');",
              "// console.log(check);",
              "// var checkinDate = checkin().format('YYYY-MM-DD');",
              "// console.log(checkinData);",
              "// pm.environment.set(\"check\", checkinDate);",
              "",
              "",
              "",
              "",
              "",
              "",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseBody = pm.response.json(); ",
              "pm.environment.set(\"Id\", responseBody.bookingid);",
              "",
              "// Assertion for the response status code",
              "pm.test(\"Verify the response code 201 or Not\", function(){",
