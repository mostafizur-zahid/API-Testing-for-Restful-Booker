    {
      "name": "GetBooking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Assertion for the response status code",
              "pm.test(\"Verify the response code 200 or Not\", function(){",
              "    pm.expect(pm.response.code).to.eql(200);",
              "})",
              "",
              "pm.test(\"Verify the response time as expected or Not\", function(){",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "})",
              "",
              "pm.test(\"Verify the response file size as expected or Not\", function(){",
              "    pm.expect(pm.response.responseSize).to.be.below(50000);",
              "})",
              "",
              "pm.test(\"Response file JSON or Not\", function(){",
              "    pm.response.to.be.json;",
              "});",
              "",
              "var responseBody = pm.response.json(); ",
              "console.log(responseBody);",
              "",
              "pm.test(\"Verify the firstname\", function(){",
              "    pm.expect(pm.environment.get(\"firstname\")).to.eql(responseBody.firstname);",
              "});",
              "pm.test(\"Verify the lastname\", function(){",
              "    pm.expect(pm.environment.get(\"lastname\")).to.eql(responseBody.lastname);",
              "});",
              "",
              "pm.test(\"Verify the totalprice\", function(){",
              "    pm.expect(Number(pm.environment.get(\"totalprice\"))).to.eql(responseBody.totalprice);",
              "});",
              "",
              "pm.test(\"Verify depositpaid\", function () {",
              "    pm.expect(pm.environment.get(\"depositpaid\") === \"true\").to.eql(responseBody.depositpaid);",
              "});",
              "",
              "",
              "pm.test(\"Verify checkin date\", function () {",
              "    pm.expect(pm.environment.get(\"checkin\")).to.eql(responseBody.bookingdates.checkin);",
              "});",
              "",
              "pm.test(\"Verify checkout date\", function () {",
              "    pm.expect(pm.environment.get(\"checkout\")).to.eql(responseBody.bookingdates.checkout);",
              "});",
              "",
              "",
              "pm.test(\"Verify additional needs\", function () {",
              "    pm.expect(pm.environment.get(\"additionalneeds\")).to.eql(responseBody.additionalneeds);",
              "});",
              "",
              "",
              ""
            ],
